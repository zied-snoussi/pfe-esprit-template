{
  "permissions": {
    "allow": [
      "Bash(sh rapport/build.sh)",
      "Bash(./rapport/build.sh)",
      "Bash(npm run diagrammes)",
      "Bash(npm run figures)",
      "Bash(npm install)",
      "Bash(python diagrammes/_source/build_diagrams.py)",
      "Bash(node diagrammes/_source/render.js:*)",
      "Bash(node rapport/figures/_source/render.js:*)",
      "Bash(python cahier/build_cahier_docx.py)",
      "Bash(python presentation/build_deck.py)",
      "Bash(pdftoppm:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/secrets/**)"
    ]
  },
  "enabledMcpjsonServers": ["context7", "playwright"]
}
